file(SHA256 "${NATIVE_FILE}" NATIVE_SHA256)
file(READ "${TEMPLATE}" MANIFEST)
string(REPLACE "NATIVE_SHA256_PLACEHOLDER" "${NATIVE_SHA256}" MANIFEST "${MANIFEST}")
get_filename_component(NATIVE_NAME "${NATIVE_FILE}" NAME)
string(REPLACE "NATIVE_NAME_PLACEHOLDER" "${NATIVE_NAME}" MANIFEST "${MANIFEST}")
file(WRITE "${OUTPUT}" "${MANIFEST}")
