{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-release",
      "displayName": "Ninja (single-config) - Release",
      "description": "Ninja 生成器，Release 构建。单配置：构建类型由 CMAKE_BUILD_TYPE 决定，无需 --config；Windows/MSVC 需在 vcvars64 环境中运行",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja (single-config) - Debug",
      "description": "Ninja 生成器，Debug 构建",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 17 2022 (MSBuild, multi-config)",
      "description": "Visual Studio 2022 MSBuild 生成器（.sln/.vcxproj），x64。多配置：Release/Debug 在构建期用 --config 选定",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-msvc"
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 18 2026 (MSBuild, multi-config)",
      "description": "Visual Studio 2026 MSBuild 生成器（.sln/.vcxproj），x64。多配置：Release/Debug 在构建期用 --config 选定",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-msvc2026"
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    }
  ]
}